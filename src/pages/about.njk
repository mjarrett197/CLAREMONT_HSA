---js
{
  title: "About CHS",
  subtitle: "Who we are and how to become a member",
  layout: "base.njk",
  // Hidden until there is something to say (src/_data/about.js, board.js).
  permalink: (data) => (data.about.objective || data.about.boardNote || data.about.requirements.length || data.board.length) ? "/about/" : false,
  seoTitle: "About | Claremont Hindu Society",
  seoDescription: "Who the Claremont Hindu Society is, its student leadership, and how to become a member."
}
---
{# Text comes from src/_data/about.js, leadership from board.js. Each
   section only appears once it has content. #}
<div class="container">

  <section class="page-hero">
    <h1>{{ title }}</h1>
    <p class="subtitle">{{ subtitle }}</p>
  </section>

  <div class="page-content">
    {% if about.objective %}
    <section id="objective" class="about-section">
      <h2>Our objective</h2>
      <p>{{ about.objective }}</p>
    </section>
    {% endif %}

    {% if board.length or about.boardNote %}
    <section id="leadership" class="about-section">
      <h2>Student leadership</h2>
      {% if about.boardNote %}<p>{{ about.boardNote }}</p>{% endif %}
    </section>
    {% endif %}
  </div>

  {% if board.length %}
  <div class="board-grid">
  {% for m in board %}
    <section class="board-card" id="{{ m.id }}">
      {% if m.photo %}
        <img class="board-photo" src="{{ m.photo }}" alt="{{ m.name }}" width="112" height="112" loading="lazy">
      {% else %}
        <div class="board-photo board-initials" aria-hidden="true">{{ m.role | first }}</div>
      {% endif %}
      <h3>{{ m.name }}</h3>
      <p class="board-role">{{ m.role }}</p>
      {% set cn = m.college | collegeName(colleges) %}
      {% if cn or m.gradYear %}<p class="board-college">{{ cn }}{% if cn and m.gradYear %} · {% endif %}{% if m.gradYear %}Class of {{ m.gradYear }}{% endif %}</p>{% endif %}
    </section>
  {% endfor %}
  </div>
  {% endif %}

  <div class="page-content">
    <section id="membership" class="about-section">
      {% if about.requirements.length %}
      <h2>Membership requirements</h2>
      <ul>
        {% for r in about.requirements %}<li>{{ r }}</li>{% endfor %}
      </ul>
      {% endif %}
      <p><a href="/join/" class="btn btn-primary">Become a Member</a></p>
    </section>
  </div>

</div>
