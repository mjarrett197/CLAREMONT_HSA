---
title: "Become a Member"
subtitle: "Join the Claremont Hindu Society"
layout: base.njk
permalink: /join/
seoTitle: "Become a Member | Claremont Hindu Society"
seoDescription: "Sign up for the Claremont Hindu Society at the Claremont Colleges. It takes about a minute."
---
{#
  Netlify Forms. Netlify finds this form when the site is deployed (the
  data-netlify attribute) and stores every submission in the Netlify
  dashboard under Forms → "membership". No server code needed.
  The hidden "bot-field" is a honeypot that catches spam bots.
#}
<div class="container">

  <section class="page-hero">
    <h1>{{ title }}</h1>
    <p class="subtitle">{{ subtitle }}</p>
  </section>

  <form class="join-form" name="membership" method="POST" action="/join/thanks/"
        data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="membership">
    <p hidden><label>Leave this empty: <input name="bot-field"></label></p>

    <div class="field">
      <label for="name">Full name</label>
      <input id="name" name="name" type="text" autocomplete="name" required>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="phone">Phone <span class="optional">(optional)</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel">
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="college">College</label>
        <select id="college" name="college" required>
          <option value="" disabled selected>Choose your college</option>
          {% for c in colleges %}<option value="{{ c.name }}">{{ c.name }}</option>{% endfor %}
        </select>
      </div>
      <div class="field">
        <label for="grad-year">Expected graduation year</label>
        <select id="grad-year" name="graduation-year" required>
          <option value="" disabled selected>Choose a year</option>
          {% for y in null | gradYears %}<option>{{ y }}</option>{% endfor %}
        </select>
      </div>
    </div>

    <label class="check">
      <input type="checkbox" name="list-on-roster" value="yes">
      <span>Also list my name, college and graduation year on the public <a href="/members/">Members</a> page. Leave this unticked to stay off it.</span>
    </label>

    <div class="privacy-note">
      <p><strong>Who sees your details</strong></p>
      <p>Your name, email, phone, college and graduation year go to the CHS student board. They are held in the CHS account on Netlify, the service that hosts this website, and copied to a Google Sheet shared only with board members. No one else can see them.</p>
      <p>Your email and phone number are never published. Your name, college and graduation year appear on the public Members page only if you tick the box above.</p>
      <p>To change or remove your details, or to come off the Members page, {% if site.contact.email %}email <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% else %}ask any CHS board member{% endif %}.</p>
    </div>

    <button type="submit" class="btn btn-primary">Become a Member</button>
  </form>

  {% if site.contact.email %}<p class="form-note">Questions? Email <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>.</p>{% endif %}

</div>
